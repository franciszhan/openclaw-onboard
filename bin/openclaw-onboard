#!/usr/bin/env bash
set -euo pipefail

# Interactive onboarding + lockout.
# This script should ultimately run the OpenClaw wizard *as the logged-in user* so
# `systemctl --user` works.
#
# You may invoke it with sudo for convenience; it will drop back to the invoking
# user for the wizard step.

OWNER_USER=${OWNER_USER:-openclaw}
SECRET_DIR=/opt/openclaw/secret
BIN_DIR=/opt/openclaw/bin

# If started via sudo/root, immediately re-exec as the invoking user so we keep
# the SSH session's user-systemd / DBus context.
if [[ ${EUID} -eq 0 && "${1:-}" != "--as-user" ]]; then
  if [[ -z "${SUDO_USER:-}" ]]; then
    echo "Run as a normal user (or via sudo from an SSH session)." >&2
    exit 1
  fi
  exec sudo -u "${SUDO_USER}" -H \
    --preserve-env=XDG_RUNTIME_DIR,DBUS_SESSION_BUS_ADDRESS,SSH_AUTH_SOCK,PATH \
    "$0" --as-user
fi

# From here on, we are running as the user in an interactive session.
if [[ "$(id -un)" != "$OWNER_USER" ]]; then
  echo "Please run as $OWNER_USER (or: sudo -u $OWNER_USER -H $0 --as-user)" >&2
  exit 1
fi

# Ensure secrets dir exists and is owned by the owner user.
sudo install -d -m 700 -o "$OWNER_USER" -g "$OWNER_USER" "$SECRET_DIR"

echo ""
echo "OpenClaw onboarding (owner: $OWNER_USER)"
echo "- secrets will be written to $SECRET_DIR (600 files)"
echo ""

read -r -p "Enable advanced Telegram read/search via Telethon user session? (y/N) " USE_TELETHON || true
if [[ "${USE_TELETHON:-}" == "y" || "${USE_TELETHON:-}" == "Y" ]]; then
  read -r -p "Telegram API_ID: " TG_API_ID
  read -r -p "Telegram API_HASH: " TG_API_HASH
  read -r -p "Telegram phone (E.164, e.g. +1718...): " TG_PHONE

  TG_ENV="$SECRET_DIR/tg.env"
  cat > "$TG_ENV" <<EOF
TG_API_ID=$TG_API_ID
TG_API_HASH=$TG_API_HASH
TG_PHONE=$TG_PHONE
EOF
  chmod 600 "$TG_ENV"
  chown "$OWNER_USER:$OWNER_USER" "$TG_ENV"

  echo ""
  echo "Running Telethon login (you'll get a code in Telegram/SMS)"
  python3 "$BIN_DIR/tg_tools.py" login --phone "$TG_PHONE"
fi

echo ""
echo "Preparing for OpenClaw wizard"
# If bootstrap installed a system-wide openclaw service, it can conflict with the wizard's daemon install.
if sudo systemctl list-unit-files | grep -q '^openclaw\.service'; then
  echo "Found existing system service openclaw.service; stopping + disabling so the wizard can install cleanly"
  sudo systemctl stop openclaw || true
  sudo systemctl disable openclaw || true
fi

echo ""
echo "Lockout / cleanup"
read -r -p "Remove bootstrap SSH keys from /home/$OWNER_USER/.ssh/authorized_keys? (y/N) " ANS || true
if [[ "${ANS:-}" == "y" || "${ANS:-}" == "Y" ]]; then
  AK="/home/$OWNER_USER/.ssh/authorized_keys"
  if [[ -f "$AK" ]]; then
    sudo cp -a "$AK" "$AK.bak.$(date -u +%Y%m%d_%H%M%S)"
    if sudo grep -q "bootstrap" "$AK"; then
      sudo sed -i '/bootstrap/d' "$AK"
      echo "Removed lines containing 'bootstrap' from $AK"
    else
      echo "No 'bootstrap' marker found in $AK."
      echo "Edit it now to remove your old key(s):"
      echo "  sudo nano $AK"
    fi
  fi
fi

echo ""
echo "Next: run the OpenClaw wizard manually (recommended)"
echo "Run this as the openclaw user (NOT via sudo), in your SSH session:"
echo ""
echo "  openclaw onboard --install-daemon"
echo ""
echo "After the wizard completes, apply security audit fixes:"
echo ""
echo "  chmod 700 /home/${OWNER_USER}/.openclaw"
echo ""
echo "If you plan to expose the Control UI through a reverse proxy, configure gateway.trustedProxies."
echo "Otherwise, keep the Control UI local-only (bind loopback) and access via SSH tunnel/Tailscale."

echo ""
echo "Onboarding step complete."
